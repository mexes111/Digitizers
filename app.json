{
  "expo": {
    "name": "Digitizers",
    "slug": "digitizers-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no"
    },
    "android": {
      "permissions": [],
      "package": "com.org.digitizersapp"
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "04ee9de5-9296-4ed5-932f-1b6150435724"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": { "useFrameworks": "static" },
          "android": { "compileSdkVersion": 34, "minSdkVersion": 23 }
        }
      ]
    ]
    
  }
}
